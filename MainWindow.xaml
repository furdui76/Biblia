<Window x:Class="Biblia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BibliaApp" Height="600" Width="800">
    <Grid HorizontalAlignment="Center" Width="760" Height="544" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="121*"/>
            <RowDefinition Height="151*"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Top" Margin="215,114,245,0" Grid.RowSpan="2" Height="250">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="0,5"/>
                </Style>
            </StackPanel.Resources>

            <!-- 🔹 Buton 1 -->
            <Button Content="📖 Biblia" Height="40" Click="OpenBibliaWindow"/>

            <!-- 🔹 Restul -->
            <Button Content="📚 Teme" Height="40" Click="OpenTemeWindow"/>
            <Button Content="🧠 Explicații" Height="40" Click="OpenExplicatiiWindow"/>
            <Button Content="🕰 Istoric biblic" Height="40" Click="OpenIstoricWindow"/>
            <Button Content="🗂 Arhivă" Height="40" Click="OpenArhivaWindow"/>
        </StackPanel>
    </Grid>
</Window>



