<Window x:Class="Biblia.FereastraIstoric"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Istoric biblic — BibliaApp" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header personalizat -->
        <Border Background="#2C3E50" Padding="10">
            <TextBlock Text="📜 Cronologia Bibliei — BibliaApp"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- WebView2 pentru timeline -->
        <wv2:WebView2 x:Name="webViewTimeline" Grid.Row="1" />
    </Grid>
</Window>
