<Window x:Class="Biblia.FereastraVerset"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📖 Verset"
        Height="350" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FAFAFA">

    <Border Margin="12"
            Padding="12"
            CornerRadius="12"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#999"
                              BlurRadius="12"
                              ShadowDepth="2"
                              Opacity="0.35"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Titlu frumos -->
                <TextBlock Text="📖 Trimiterea selectată"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"
                           Margin="0,0,0,10"
                           TextAlignment="Center"/>

                <!-- Textul versetului -->
                <TextBlock x:Name="textVerset"
                           TextWrapping="Wrap"
                           FontSize="18"
                           Foreground="#222"
                           LineHeight="28"
                           TextAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>

    </Border>
</Window>

